{
  "name": "@hookwars/sdk",
  "version": "0.5.0",
  "type": "module",
  "description": "TypeScript client of the Hookwars programs (derived from @bordrless/sdk).",
  "license": "Apache-2.0",
  "keywords": [
    "solana",
    "bordrless",
    "hooks",
    "dex",
    "launchpad",
    "anchor"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "idl"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@hookwars/shared": "workspace:^",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.5"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "private": true
}
