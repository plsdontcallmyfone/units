# units on Solana devnet (docs/DEVNET.md). No secrets here: DATABASE_URL and any private RPC URL
# come from the server's own environment. Load with `set -a; . ./devnet.env; set +a` before
# starting the api, indexer, web or agents.
CLUSTER=devnet
