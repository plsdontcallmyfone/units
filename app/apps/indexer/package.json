{
  "name": "@hookwars/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hookwars indexer: per-program signature cursors, self-CPI and log events, Postgres (docs/spec/06-app.md section 2).",
  "scripts": {
    "migrate": "node src/main.ts migrate",
    "once": "node src/main.ts once",
    "start": "node src/main.ts run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hookwars/sdk": "workspace:^",
    "@hookwars/shared": "workspace:^",
    "@solana/web3.js": "1.98.4",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "exports": {
    "./*": "./src/*"
  }
}
