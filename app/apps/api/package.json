{
  "name": "@hookwars/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hookwars API: reads from the indexer's Postgres, prepares transactions with the SDK (docs/spec/06-app.md sections 3 to 5).",
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hookwars/indexer": "workspace:^",
    "@hookwars/sdk": "workspace:^",
    "@hookwars/shared": "workspace:^",
    "@solana/web3.js": "1.98.4",
    "pg": "8.16.3",
    "sharp": "0.34.4",
    "bs58": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
