PROTOCOL_LOOKUP_TABLE=7piuvZj2xJM7dj5fnB4sC8JujnyvRBa3J7bmtTAXbHUu
HOST=127.0.0.1
PORT=9961
API_URL=http://127.0.0.1:9961
