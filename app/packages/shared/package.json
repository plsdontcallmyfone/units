{
  "name": "@hookwars/shared",
  "version": "0.5.0",
  "type": "module",
  "description": "Hookwars policy math, program addresses and API types shared by the server and the site (derived from @bordrless/shared). No Solana dependencies.",
  "license": "Apache-2.0",
  "keywords": [
    "solana",
    "bordrless",
    "hooks",
    "dex",
    "launchpad",
    "anchor"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "private": true
}
